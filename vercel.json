{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/**/*.py": {
      "excludeFiles": "{tests/**,__tests__/**,**/*.test.py,**/test_*.py,fixtures/**,__fixtures__/**,testdata/**,static/**,assets/**}",
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/app.py" }
  ]
}
